# --- local (no Docker) run: all optional ---
DB_URL=sqlite:///./deployboard.db      # or postgresql+psycopg://user:pass@host/db
DB_WORKSPACE=./workspaces
DB_KEEP_WORKSPACE=0
DB_KEY_FILE=./.secret.key              # generated on first start if DB_SECRET_KEY is empty
# DB_SECRET_KEY=                       # Fernet key; REQUIRED when API and worker run as separate processes
DB_REDIS_URL=                          # empty = in-process queue; redis://localhost:6379/0 = shared queue
DB_WORKERS=2
DB_EMBEDDED_WORKERS=1                  # 0 = API only (run `python -m app.worker_main` separately)
DB_LEASE_SECONDS=30                    # worker heartbeat lease; a job whose lease expires is re-queued
DB_REAPER_INTERVAL=10
DB_MAX_ATTEMPTS=3                      # give up on a job after its worker was lost this many times
DB_RUNNER=local                        # local | docker
DB_STAGE_TIMEOUT=600
DB_DEPLOYMENT_TIMEOUT=1800
DB_RUNNER_IMAGE=node:22
DB_RUNNER_CPUS=2
DB_RUNNER_MEMORY=2g
DB_DOCKER_NETWORK=                     # optional network for deployed app containers
DB_TOKEN_TTL_HOURS=168
# --- docker compose ---
# POSTGRES_PASSWORD=
# DEPLOYBOARD_WORKSPACE=/var/lib/deployboard/workspaces

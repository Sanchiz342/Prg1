# HTTP
HTTP_ADDR=:8080
# Public origin used to build short URLs (and to reject links pointing back at the shortener)
BASE_URL=http://localhost:8080
# json for structured logs
LOG_FORMAT=text

# Storage
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shortener?sslmode=disable
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=snip:

# Behind a proxy that overwrites X-Real-IP (see deploy/nginx.conf): trust it and the country header
TRUST_PROXY=false
GEO_HEADER=CF-IPCountry
# Secret for unique-visitor hashing; must be identical on all instances
VISITOR_SALT=change-me

# Cache
CACHE_TTL=1h
NEGATIVE_CACHE_TTL=30s

# Token-bucket rate limits (tokens per second / burst)
RL_REDIRECT_RATE=20
RL_REDIRECT_BURST=60
RL_CREATE_RATE=0.5
RL_CREATE_BURST=20
RL_API_RATE=10
RL_API_BURST=40
# true: allow requests when Redis is unavailable; false: answer 503
RATE_LIMIT_FAIL_OPEN=true

# Click pipeline
WORKER_ENABLED=true
STREAM_MAXLEN=1000000
EVENT_BUFFER=10000

# Optional: create this API key at startup (idempotent), handy for demos
# BOOTSTRAP_API_KEY=snip_demo_key_change_me
# BOOTSTRAP_API_KEY_NAME=bootstrap

# --- auth (CHANGE ALL OF THESE outside local dev) ---
JWT_SECRET=change-me-in-production-please-32b!
ADMIN_USER=admin
ADMIN_PASSWORD=admin
VIEWER_USER=viewer
VIEWER_PASSWORD=viewer
INGEST_API_KEY=dev-ingest-key

# --- AI ---
# local  : only local models, nothing leaves the server
# cloud  : context sent to AI_PROVIDER as-is
# hybrid : context is redacted locally, then sent to AI_PROVIDER (recommended)
AI_MODE=hybrid
AI_PROVIDER=mock            # mock | openai | anthropic | ollama
AI_LOCAL_PROVIDER=mock      # provider used in local mode: mock | ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

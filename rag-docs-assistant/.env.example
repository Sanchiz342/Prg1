# Storage
RAG_DB_PATH=data/rag.sqlite3
# Index sample_docs/ into an empty database on startup
RAG_SEED_SAMPLES=true

# Embeddings: hashing (offline, default) | sentence-transformers (pip install -r requirements-optional.txt)
RAG_EMBEDDER=hashing
RAG_EMBED_DIM=1024
RAG_ST_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Answer generation: extractive (offline, default) | ollama | anthropic
RAG_PROVIDER=extractive
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# ANTHROPIC_API_KEY=sk-ant-...

# Chunking / retrieval
RAG_CHUNK_WORDS=120
RAG_CHUNK_OVERLAP=30
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.12

# API
RAG_MAX_UPLOAD_MB=20
# When set, uploads/deletes require the X-API-Key header
# RAG_API_KEY=change-me
